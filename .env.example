# Database and auth
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

# Stripe. Use Stripe test-mode keys for market testing first.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Dropshipping safety control. Keep this set to simulation until every pilot SKU and
# supplier shipping term has been approved.
DROPSHIPPING_MODE=simulation

# CJ Dropshipping. These are server-side secrets; do not expose them to the browser
# or commit a populated .env file.
CJ_ACCESS_TOKEN=replace_me
CJ_PLATFORM_TOKEN=
CJ_OPEN_ID=replace_me
CJ_LOGISTIC_NAME=replace_with_an_approved_cj_logistics_service
CJ_FROM_COUNTRY_CODE=CN
# CJ_PAYMENT_MODE=create_only uses CJ payType=3. Set balance only after approval.
CJ_PAYMENT_MODE=create_only
